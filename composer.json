{
    "name": "queuey/symfony",
    "description": "Symfony bundle for queuey: container wiring, configuration, console commands, events and test doubles for the pure-PHP, Rust-wire-compatible job queue.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Jaap Elst",
            "homepage": "https://github.com/jaapieaapie1"
        }
    ],
    "homepage": "https://github.com/jaapieaapie1/queuey-symfony",
    "support": {
        "issues": "https://github.com/jaapieaapie1/queuey-symfony/issues",
        "source": "https://github.com/jaapieaapie1/queuey-symfony",
        "docs": "https://github.com/jaapieaapie1/queuey-symfony/blob/main/README.md"
    },
    "keywords": [
        "queue",
        "jobs",
        "worker",
        "rabbitmq",
        "amqp",
        "symfony",
        "bundle"
    ],
    "require": {
        "php": "^8.3",
        "psr/container": "^2",
        "psr/log": "^3",
        "queuey/queuey": "^1.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "ext-pcntl": "Graceful SIGTERM/SIGINT shutdown and per-job timeouts for queuey:work"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "pestphp/pest": "^4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Queuey\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Queuey\\Symfony\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "pest",
        "test:integration": "pest --testsuite Integration",
        "test:all": "pest --testsuite Unit,Feature,Integration",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the unit and feature suites with Pest.",
        "test:integration": "Run the broker-backed suite with Pest (needs AMQP_URL).",
        "test:all": "Run every Pest suite.",
        "stan": "Run PHPStan at level max.",
        "cs": "Check coding standards without writing.",
        "cs:fix": "Fix coding standards in place.",
        "check": "Run cs, stan and the unit and feature suites."
    }
}
